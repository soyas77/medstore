# =============================================================================
# MedStore — ROOT environment (used by docker-compose.yml / .prod.yml)
# Copy to `.env` and fill in. NEVER commit the real .env.
# =============================================================================

# ---- Postgres ----
POSTGRES_USER=medstore
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=medstore
POSTGRES_PORT=5432

# ---- Backend / JWT ----
# Generate a strong secret:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-64-char-hex-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS: comma-separated list of allowed frontend origins (prod = your domain)
CORS_ORIGINS=http://localhost:3000

# Seed admin (created by the initial Alembic migration)
FIRST_ADMIN_EMAIL=admin@medstore.test
FIRST_ADMIN_PASSWORD=change-me-admin-password
FIRST_ADMIN_NAME=MedStore Admin

# Run alembic on container start (1=yes). Set 0 if a separate job handles it.
RUN_MIGRATIONS=1

# ---- Frontend (NEXT_PUBLIC_* are baked at build time in prod) ----
# Dev: http://localhost:8000   |   Prod: https://medstore.example.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- Images (prod: pull from GHCR) ----
BACKEND_IMAGE=ghcr.io/your-org/medstore-backend
FRONTEND_IMAGE=ghcr.io/your-org/medstore-frontend
IMAGE_TAG=latest

# ---- Logging ----
LOG_LEVEL=info        # debug | info | warning | error

# ---- Observability (leave empty to DISABLE Sentry) ----
SENTRY_DSN_BACKEND=
SENTRY_DSN_FRONTEND=

# ---- TLS / domain (prod) ----
DOMAIN=medstore.example.com
CERTBOT_EMAIL=ops@medstore.example.com

# ---- Backups (scripts/backup-db.sh) ----
BACKUP_S3_BUCKET=s3://your-bucket/medstore-backups
AWS_REGION=us-east-1
# AWS creds via IAM role in prod; locally use the AWS CLI default profile.

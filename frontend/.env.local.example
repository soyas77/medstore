# =============================================================================
# MedStore FRONTEND — environment
# NEXT_PUBLIC_* values are inlined at BUILD time. In production they must be
# passed as Docker build args (see docker-compose.prod.yml / Dockerfile).
# =============================================================================

# Base URL of the MedStore backend (FastAPI). The axios client points here.
#   Dev:  http://localhost:8000
#   Prod: https://medstore.example.com   (nginx routes /api/* to the backend)
NEXT_PUBLIC_API_URL=http://localhost:8000

# When "1", the bundled Next.js route handlers under /app/api serve mock data,
# so the frontend runs end-to-end without a real backend.
# Set to "0" to call the real backend at NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_USE_MOCK_API=1

# Name of the httpOnly auth cookie (kept in sync with middleware + handlers).
AUTH_COOKIE_NAME=medstore_token

# ---- Observability ----
# Sentry is DISABLED automatically when the DSN is empty.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# App version surfaced by /api/health (CI sets this to the commit SHA).
NEXT_PUBLIC_APP_VERSION=dev

# =============================================================================
# MedStore BACKEND — environment (standalone / non-Docker runs)
# When using docker-compose, these are injected from the ROOT .env instead.
# =============================================================================

# ---- Application ----
APP_NAME=MedStore
ENVIRONMENT=development        # development | production
DEBUG=true

# ---- Database (async driver) ----
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+asyncpg://medstore:medstore@localhost:5432/medstore

# ---- JWT / Auth ----
# Generate:  openssl rand -hex 32
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- CORS (comma-separated origins) ----
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Seed admin (used by the initial Alembic migration) ----
FIRST_ADMIN_EMAIL=admin@medstore.test
FIRST_ADMIN_PASSWORD=admin123
FIRST_ADMIN_NAME=MedStore Admin

# ---- Logging ----
LOG_LEVEL=info                # debug | info | warning | error
LOG_JSON=false               # true => structured JSON logs (structlog) for prod

# ---- Observability ----
# Sentry is DISABLED automatically when SENTRY_DSN is empty.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---- Server (prod) ----
WEB_CONCURRENCY=4            # gunicorn uvicorn workers
PORT=8000
RUN_MIGRATIONS=1
